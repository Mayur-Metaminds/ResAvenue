{
  "kind": "collectionType",
  "collectionName": "contact_submissions",
  "info": {
    "singularName": "contact-submission",
    "pluralName": "contact-submissions",
    "displayName": "Contact Submission",
    "description": "Lead submissions from the public contact form."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "firstName": {
      "type": "string",
      "maxLength": 100,
      "required": true
    },
    "lastName": {
      "type": "string",
      "maxLength": 100,
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "maxLength": 32,
      "required": true
    },
    "propertyName": {
      "type": "string",
      "maxLength": 200,
      "required": true
    },
    "siteUrl": {
      "type": "string",
      "maxLength": 500
    },
    "message": {
      "type": "text"
    },
    "services": {
      "type": "json"
    }
  }
}
